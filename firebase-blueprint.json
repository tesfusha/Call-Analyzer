{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Private user account preferences (theme, tariffs, SIM labels, calendar defaults, reminder settings, voice bundles). Contains NO call logs, contact phone numbers, or scheduled calls.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "termsAccepted": {
          "type": "boolean"
        },
        "termsAcceptedAt": {
          "type": "integer"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "dark-gray", "light"]
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "privacyMode": {
          "type": "boolean"
        },
        "tariffs": {
          "type": "object"
        },
        "simLabels": {
          "type": "object"
        },
        "calendarPrefs": {
          "type": "object"
        },
        "reminderPrefs": {
          "type": "object"
        },
        "voiceBundles": {
          "type": "object"
        },
        "syncedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "theme",
        "notificationsEnabled",
        "privacyMode",
        "tariffs",
        "simLabels",
        "calendarPrefs",
        "reminderPrefs",
        "syncedAt"
      ]
    },
    "RegisteredUser": {
      "title": "RegisteredUser",
      "description": "Basic registered user account summary (name, email, avatar, registration & activity timestamps) for admin totals without customer or call-log PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "authProvider": {
          "type": "string",
          "enum": ["google", "password"],
          "maxLength": 24
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "registeredAt",
        "lastActiveAt"
      ]
    },
    "DailyActive": {
      "title": "DailyActive",
      "description": "Once-per-day active client ping written on app open by a verified signed-in user at /dailyActive/{yyyy-MM-dd}_{uid}. Readable only by admins; immutable after creation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "openedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "date",
        "openedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Console-managed admin allowlist document keyed by verified user UID.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserWorkspace"
      },
      "description": "User workspace preferences (tariffs, SIM labels, calendar defaults, reminder controls, theme). Call logs, contacts, and scheduled calls are never stored in Firestore."
    },
    "/userRegistry/{userId}": {
      "schema": {
        "$ref": "#/entities/RegisteredUser"
      },
      "description": "Basic registered user account summaries for admin total user counts; excludes all customer contacts and call data."
    },
    "/dailyActive/{activityId}": {
      "schema": {
        "$ref": "#/entities/DailyActive"
      },
      "description": "Minimal daily active client pings keyed by {yyyy-MM-dd}_{uid}. Owner create-only; nobody can update or delete; admin read-only."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminRole"
      },
      "description": "Console-managed admin role allowlist. Readable only by the matching verified UID; never writable by clients."
    }
  }
}
