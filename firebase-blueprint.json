{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Private user account preferences (theme, tariffs, SIM labels, calendar defaults, reminder settings, voice bundles). Contains NO call logs, contact phone numbers, scheduled calls, wish templates, sent wishes, social usernames, or reconnect progress.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "termsAccepted": {
          "type": "boolean"
        },
        "termsAcceptedAt": {
          "type": "integer"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "dark-gray", "light"]
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "tariffs": {
          "type": "object"
        },
        "simLabels": {
          "type": "object"
        },
        "calendarPrefs": {
          "type": "object"
        },
        "reminderPrefs": {
          "type": "object"
        },
        "voiceBundles": {
          "type": "object"
        },
        "syncedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "theme",
        "notificationsEnabled",
        "tariffs",
        "simLabels",
        "calendarPrefs",
        "reminderPrefs",
        "syncedAt"
      ]
    },
    "RegisteredUser": {
      "title": "RegisteredUser",
      "description": "Basic registered user account summary (name, email, avatar, registration & activity timestamps) for admin totals without customer or call-log PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "authProvider": {
          "type": "string",
          "enum": ["google", "password"],
          "maxLength": 24
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "registeredAt",
        "lastActiveAt"
      ]
    },
    "DailyActive": {
      "title": "DailyActive",
      "description": "Once-per-day active client ping written on app open by a verified signed-in user at /dailyActive/{yyyy-MM-dd}_{uid}. Readable only by admins; immutable after creation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "openedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "date",
        "openedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Console-managed admin allowlist document keyed by verified user UID.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "BroadcastMessage": {
      "title": "BroadcastMessage",
      "description": "Admin-published in-app update or announcement broadcast shown to verified users (banner, ticker, ribbon strip, or popup).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500
        },
        "kind": {
          "type": "string",
          "enum": ["update", "announcement", "tip", "urgent"]
        },
        "displayMode": {
          "type": "string",
          "enum": ["banner", "ticker", "ribbon", "popup"]
        },
        "audience": {
          "type": "string",
          "enum": ["all", "android", "web"]
        },
        "actionLabel": {
          "type": "string",
          "maxLength": 40
        },
        "actionUrl": {
          "type": "string",
          "maxLength": 300
        },
        "active": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "message",
        "kind",
        "displayMode",
        "audience",
        "active",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportThread": {
      "title": "SupportThread",
      "description": "Direct user-to-admin support conversation thread keyed by the verified user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "userEmail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        },
        "userPhotoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"]
        },
        "lastMessageText": {
          "type": "string",
          "maxLength": 300
        },
        "lastMessageSender": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time"
        },
        "unreadByAdmin": {
          "type": "boolean"
        },
        "unreadByUser": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "userName",
        "userEmail",
        "status",
        "lastMessageText",
        "lastMessageSender",
        "lastMessageAt",
        "unreadByAdmin",
        "unreadByUser",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Immutable chat message inside a user's support thread.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderRole": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "threadUid",
        "senderUid",
        "senderRole",
        "senderName",
        "text",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserWorkspace"
      },
      "description": "User workspace preferences (tariffs, SIM labels, calendar defaults, reminder controls, theme). Call logs, contacts, and scheduled calls are never stored in Firestore."
    },
    "/userRegistry/{userId}": {
      "schema": {
        "$ref": "#/entities/RegisteredUser"
      },
      "description": "Basic registered user account summaries for admin total user counts; excludes all customer contacts and call data."
    },
    "/dailyActive/{activityId}": {
      "schema": {
        "$ref": "#/entities/DailyActive"
      },
      "description": "Minimal daily active client pings keyed by {yyyy-MM-dd}_{uid}. Owner create-only; nobody can update or delete; admin read-only."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminRole"
      },
      "description": "Console-managed admin role allowlist. Readable only by the matching verified UID; never writable by clients."
    },
    "/broadcasts/{broadcastId}": {
      "schema": {
        "$ref": "#/entities/BroadcastMessage"
      },
      "description": "Admin-managed app updates and announcements. Admin write-only; verified users can read active broadcasts."
    },
    "/supportThreads/{threadUid}": {
      "schema": {
        "$ref": "#/entities/SupportThread"
      },
      "description": "Direct user-to-admin support chat threads keyed by the verified user UID. Readable and writable only by the thread owner or an admin."
    },
    "/supportThreads/{threadUid}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/SupportMessage"
      },
      "description": "Immutable chat messages inside a support thread. Accessible only to the thread owner or an admin."
    }
  }
}
