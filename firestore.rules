rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything (including legacy /calls, /contacts, /scheduledCalls)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNullableString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidTariffs(t) {
      return t is map
        && t.keys().hasAll(['sim1RatePerMin', 'sim2RatePerMin', 'billingMode', 'monthlyBudgetEtb'])
        && t.keys().hasOnly(['sim1RatePerMin', 'sim2RatePerMin', 'billingMode', 'monthlyBudgetEtb'])
        && t.sim1RatePerMin is number && t.sim1RatePerMin >= 0 && t.sim1RatePerMin <= 1000
        && t.sim2RatePerMin is number && t.sim2RatePerMin >= 0 && t.sim2RatePerMin <= 1000
        && t.billingMode in ['per-second', 'per-minute']
        && t.monthlyBudgetEtb is number && t.monthlyBudgetEtb >= 0 && t.monthlyBudgetEtb <= 1000000;
    }

    function isValidSimLabels(s) {
      return s is map
        && s.keys().hasAll(['sim1Label', 'sim2Label'])
        && s.keys().hasOnly(['sim1Label', 'sim2Label'])
        && isBoundedString(s.sim1Label, 1, 40)
        && isBoundedString(s.sim2Label, 1, 40);
    }

    function isValidCalendarPrefs(c) {
      return c is map
        && c.keys().hasAll(['defaultLang', 'defaultGeezNumerals', 'dateDisplay'])
        && c.keys().hasOnly(['defaultLang', 'defaultGeezNumerals', 'dateDisplay'])
        && c.defaultLang in ['english', 'amharic']
        && c.defaultGeezNumerals is bool
        && c.dateDisplay in ['ec-first', 'both'];
    }

    function isValidReminderPrefs(r) {
      return r is map
        && r.keys().hasAll([
          'callbackDelayMinutes',
          'missedCallReminderEnabled',
          'missedCallReminderDelayMinutes',
          'eventLeadDays',
          'quietContactDays',
          'quietHoursEnabled',
          'quietStartHour',
          'quietEndHour'
        ])
        && r.keys().hasOnly([
          'callbackDelayMinutes',
          'missedCallReminderEnabled',
          'missedCallReminderDelayMinutes',
          'onlySavedContactsReminder',
          'weeklyReconnectGoal',
          'eventLeadDays',
          'quietContactDays',
          'quietHoursEnabled',
          'quietStartHour',
          'quietEndHour'
        ])
        && r.callbackDelayMinutes is number && r.callbackDelayMinutes >= 5 && r.callbackDelayMinutes <= 1440
        && r.missedCallReminderEnabled is bool
        && r.missedCallReminderDelayMinutes is number
        && (r.missedCallReminderDelayMinutes == 5 || r.missedCallReminderDelayMinutes == 7 || r.missedCallReminderDelayMinutes == 10)
        && (!('onlySavedContactsReminder' in r) || r.onlySavedContactsReminder is bool)
        && (!('weeklyReconnectGoal' in r) || (r.weeklyReconnectGoal is number && r.weeklyReconnectGoal >= 1 && r.weeklyReconnectGoal <= 14))
        && r.eventLeadDays is number && r.eventLeadDays >= 0 && r.eventLeadDays <= 60
        && r.quietContactDays is number && r.quietContactDays >= 3 && r.quietContactDays <= 180
        && r.quietHoursEnabled is bool
        && r.quietStartHour is number && r.quietStartHour >= 0 && r.quietStartHour <= 23
        && r.quietEndHour is number && r.quietEndHour >= 0 && r.quietEndHour <= 23;
    }

    function isValidVoiceBundleSlot(b) {
      return b is map
        && b.keys().hasAll(['enabled', 'name', 'totalMinutes', 'priceEtb', 'startedAt', 'expiresAt'])
        && b.keys().hasOnly(['enabled', 'name', 'totalMinutes', 'priceEtb', 'startedAt', 'expiresAt'])
        && b.enabled is bool
        && isBoundedString(b.name, 0, 60)
        && b.totalMinutes is number && b.totalMinutes >= 0 && b.totalMinutes <= 100000
        && b.priceEtb is number && b.priceEtb >= 0 && b.priceEtb <= 1000000
        && b.startedAt is number && b.startedAt >= 0
        && b.expiresAt is number && b.expiresAt >= 0;
    }

    function isValidVoiceBundles(vb) {
      return vb is map
        && vb.keys().hasAll(['sim1', 'sim2'])
        && vb.keys().hasOnly(['sim1', 'sim2'])
        && isValidVoiceBundleSlot(vb.sim1)
        && isValidVoiceBundleSlot(vb.sim2);
    }

    function isValidUserWorkspace(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'theme',
          'notificationsEnabled',
          'tariffs',
          'simLabels',
          'calendarPrefs',
          'reminderPrefs',
          'syncedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'phone',
          'photoURL',
          'termsAccepted',
          'termsAcceptedAt',
          'theme',
          'notificationsEnabled',
          'tariffs',
          'simLabels',
          'calendarPrefs',
          'reminderPrefs',
          'voiceBundles',
          'syncedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && isBoundedString(data.displayName, 0, 120)
        && isBoundedString(data.email, 0, 254)
        && (!('email' in request.auth.token) || !(request.auth.token.email is string) || data.email.lower() == request.auth.token.email.lower())
        && (!('phone' in data) || isNullableString(data.phone, 40))
        && (!('photoURL' in data) || isNullableString(data.photoURL, 500))
        && (!('termsAccepted' in data) || data.termsAccepted is bool)
        && (!('termsAcceptedAt' in data) || data.termsAcceptedAt == null || (data.termsAcceptedAt is number && data.termsAcceptedAt >= 0))
        && data.theme in ['dark', 'dark-gray', 'light']
        && data.notificationsEnabled is bool
        && isValidTariffs(data.tariffs)
        && isValidSimLabels(data.simLabels)
        && isValidCalendarPrefs(data.calendarPrefs)
        && isValidReminderPrefs(data.reminderPrefs)
        && (!('voiceBundles' in data) || isValidVoiceBundles(data.voiceBundles))
        && data.syncedAt is timestamp;
    }

    function isValidRegisteredUser(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'registeredAt',
          'lastActiveAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'phone',
          'authProvider',
          'photoURL',
          'registeredAt',
          'lastActiveAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && isBoundedString(data.displayName, 0, 120)
        && isBoundedString(data.email, 1, 254)
        && (!('email' in request.auth.token) || !(request.auth.token.email is string) || data.email.lower() == request.auth.token.email.lower())
        && (!('phone' in data) || isNullableString(data.phone, 40))
        && (!('authProvider' in data) || data.authProvider == null || data.authProvider in ['google', 'password'])
        && (!('photoURL' in data) || isNullableString(data.photoURL, 500))
        && data.registeredAt is timestamp
        && data.lastActiveAt is timestamp;
    }

    function isValidDailyActive(data, activityId) {
      return data.keys().hasAll(['uid', 'date', 'openedAt'])
        && data.keys().hasOnly(['uid', 'date', 'openedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && activityId == data.date + '_' + request.auth.uid
        && data.openedAt == request.time;
    }

    // Console-managed admin allowlist (clients can only read their own UID document).
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isVerifiedUser() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    // Once-per-day active client ping (/dailyActive/{yyyy-MM-dd}_{uid}).
    // Owner can create once with exact fields; nobody can update or delete; only admin can read.
    match /dailyActive/{activityId} {
      allow get: if isValidId(activityId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(activityId)
        && isVerifiedUser()
        && isValidDailyActive(incoming(), activityId);
      allow update, delete: if false;
    }

    // Basic registered user directory for admin totals only (no customer/call-log PII).
    match /userRegistry/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidRegisteredUser(incoming(), userId)
        && incoming().registeredAt == request.time
        && incoming().lastActiveAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidRegisteredUser(incoming(), userId)
        && (!('uid' in existing()) || existing().uid == request.auth.uid)
        && incoming().uid == request.auth.uid
        && incoming().registeredAt == existing().registeredAt
        && incoming().lastActiveAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'phone',
          'authProvider',
          'photoURL',
          'lastActiveAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId) && (!('uid' in existing()) || existing().uid == request.auth.uid);
    }

    // Private per-user account settings (Admin has ZERO read/write access here;
    // call logs, contacts, and scheduled calls are strictly local in IndexedDB).
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId) && (resource == null || !('uid' in existing()) || existing().uid == request.auth.uid);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().syncedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && (!('uid' in existing()) || existing().uid == null || existing().uid == '' || existing().uid == request.auth.uid)
        && incoming().uid == request.auth.uid
        && incoming().syncedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'email',
            'phone',
            'photoURL',
            'termsAccepted',
            'termsAcceptedAt',
            'theme',
            'notificationsEnabled',
            'tariffs',
            'simLabels',
            'calendarPrefs',
            'reminderPrefs',
            'voiceBundles',
            'syncedAt',
            'passwordHint',
            'privacyMode',
            'favorites',
            'dismissedMissedIds',
            'mutedAlertKeys',
            'calls',
            'contacts',
            'scheduledCalls',
            'createdAt',
            'updatedAt',
            'profileName',
            'userPhotoUrl',
            'pinHash',
            'streaks',
            'badges',
            'pointsHistory',
            'contactMilestones',
            'callsTabState',
            'wishTemplates',
            'sentWishes',
            'snoozedQuietUntil',
            'reconnectProgress',
            'alertTypePrefs',
            'alertSnoozedDate',
            'readAlertKeys',
            'fontSizeScale',
            'expandedSettingsSections'
          ])
          || (
            (!('uid' in existing()) || existing().uid == null || existing().uid == '')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid',
              'displayName',
              'email',
              'phone',
              'photoURL',
              'termsAccepted',
              'termsAcceptedAt',
              'theme',
              'notificationsEnabled',
              'tariffs',
              'simLabels',
              'calendarPrefs',
              'reminderPrefs',
              'voiceBundles',
              'syncedAt',
              'passwordHint',
              'privacyMode',
              'favorites',
              'dismissedMissedIds',
              'mutedAlertKeys',
              'calls',
              'contacts',
              'scheduledCalls',
              'createdAt',
              'updatedAt',
              'profileName',
              'userPhotoUrl',
              'pinHash',
              'streaks',
              'badges',
              'pointsHistory',
              'contactMilestones',
              'callsTabState',
              'wishTemplates',
              'sentWishes',
              'snoozedQuietUntil',
              'reconnectProgress',
              'alertTypePrefs',
              'alertSnoozedDate',
              'readAlertKeys',
              'fontSizeScale',
              'expandedSettingsSections'
            ])
          )
        );
      allow delete: if isValidId(userId) && isOwner(userId) && (!('uid' in existing()) || existing().uid == null || existing().uid == '' || existing().uid == request.auth.uid);
    }
  }
}
